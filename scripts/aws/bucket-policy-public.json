{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AnonymousReadPublicTaggedObjects",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::uo-cgf/*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/access": "public"
        }
      }
    }
  ]
}
